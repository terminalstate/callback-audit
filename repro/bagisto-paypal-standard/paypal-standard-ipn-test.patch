+
+// ============================================================================
+// Standard IPN
+// ============================================================================
+
+it('should place the order from a verified Completed IPN when the buyer never returned', function () {
+    $cart = $this->createCartWithItems('paypal_standard');
+
+    Http::fake(['*paypal.com/*' => Http::response('VERIFIED')]);
+
+    $ipn = [
+        'txn_type' => 'cart',
+        'invoice' => (string) $cart->id,
+        'payment_status' => 'Completed',
+        'mc_gross' => (string) $cart->grand_total,
+        'mc_currency' => $cart->cart_currency_code,
+        'txn_id' => '1AB23456CD789012E',
+        'receiver_email' => 'merchant@example.test',
+    ];
+
+    $first = $this->post(route('paypal.standard.ipn'), $ipn);
+
+    $retry = $this->post(route('paypal.standard.ipn'), $ipn);
+
+    expect([$first->status(), $retry->status()])->toBe([200, 200])
+        ->and(Order::query()->where('cart_id', $cart->id)->exists())->toBeTrue();
+});
+
+it('should complete the order from a verified Completed IPN after the buyer returned', function () {
+    $cart = $this->createCartWithItems('paypal_standard');
+
+    withSession([StandardController::INTENT_KEY => $cart->id])
+        ->get(route('paypal.standard.success'))
+        ->assertRedirect(route('shop.checkout.onepage.success'));
+
+    $order = Order::query()->where('cart_id', $cart->id)->firstOrFail();
+
+    Http::fake(['*paypal.com/*' => Http::response('VERIFIED')]);
+
+    $this->post(route('paypal.standard.ipn'), [
+        'txn_type' => 'cart',
+        'invoice' => (string) $cart->id,
+        'payment_status' => 'Completed',
+        'mc_gross' => (string) $order->grand_total,
+        'mc_currency' => $order->order_currency_code,
+        'txn_id' => '1AB23456CD789012F',
+        'receiver_email' => 'merchant@example.test',
+    ])->assertOk();
+
+    expect($order->refresh()->status)->toBe('processing');
+});
