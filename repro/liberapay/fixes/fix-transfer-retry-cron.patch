+def retry_unexecuted_stripe_transfers():
+    """Retry the Stripe transfers that couldn't be executed when their charge succeeded.
+
+    `execute_transfer()` leaves a transfer in `pending` without a `remote_id`
+    when Stripe refuses or fails to create it. Settling the charge again
+    retries it (the idempotency key is per transfer).
+    """
+    db = website.db
+    payins = db.all("""
+        SELECT pi
+          FROM payins pi
+          JOIN exchange_routes r ON r.id = pi.route
+         WHERE pi.status = 'succeeded'
+           AND r.network::text LIKE 'stripe-%%'
+           AND pi.id IN (
+                   SELECT pt.payin
+                     FROM payin_transfers pt
+                    WHERE pt.status = 'pending'
+                      AND pt.remote_id IS NULL
+               )
+           AND pi.ctime < (current_timestamp - interval '1 hour')
+      ORDER BY pi.id
+    """)
+    for payin in payins:
+        try:
+            settle_charge(db, payin, stripe.Charge.retrieve(payin.remote_id))
+        except Exception as e:
+            website.tell_sentry(e)
